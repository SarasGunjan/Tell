# Tell Platform Environment Configuration Template
# Copy this file to .env and populate your credentials

# Snowflake Cortex REST API Configuration (Member 3)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
# Programmatic access token (Snowsight: Settings -> Authentication). Passwords do not work with the REST API.
SNOWFLAKE_PAT=
SNOWFLAKE_DATABASE=TELL_SECURITY
SNOWFLAKE_SCHEMA=INTELLIGENCE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ANALYST
SNOWFLAKE_CORTEX_MODEL=mistral-large2

# Google Gemini API Configuration (Member 3 / Optional)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# IBM watsonx.ai / Granite Configuration (Member 2)
IBM_WATSONX_APIKEY=your_ibm_api_key
IBM_WATSONX_PROJECT_ID=your_project_id
IBM_GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Server & Dashboard Configuration
TELL_HOST=0.0.0.0
TELL_PORT=8501
TELL_ENV=production
